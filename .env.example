# Nyaya backend — local development environment template.
#
# Copy this file to `.env` and fill in values for your machine.
# NEVER commit the real `.env` file, and NEVER put actual secrets
# (API keys, passwords, tokens, credentials) in this template.

# --- Application -------------------------------------------------------------
APP_NAME=Nyaya
APP_ENV=local                      # local | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- Storage / infrastructure (later phases) ---------------------------------
# Local defaults for docker-compose style setups; adjust to your environment.
DATABASE_URL=postgresql+asyncpg://nyaya:nyaya@localhost:5432/nyaya
QDRANT_URL=http://localhost:6333
QDRANT_BNS_COLLECTION=bns_chunks
QDRANT_USER_DOCUMENT_COLLECTION=user_document_chunks
REDIS_URL=redis://localhost:6379/0

# --- LLM provider -------------------------------------------------------------
# Keyless local path is Ollama (DECISIONS.md D-033). Hosted providers (D-034)
# require an API key — set it only in your local `.env`, never here.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
# LLM_API_KEY=                    # secret — set in .env only, leave blank here

# --- Embeddings / retrieval (later phases) ------------------------------------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32
DENSE_TOP_K=20
SPARSE_TOP_K=20

# --- Uploads (later phases) ----------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_TYPES=application/pdf
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=5
