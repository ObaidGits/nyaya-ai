# Nyaya backend — local development environment template.
#
# Copy this file to `.env` and fill in values for your machine.
# NEVER commit the real `.env` file, and NEVER put actual secrets
# (API keys, passwords, tokens, credentials) in this template.

# --- Application -------------------------------------------------------------
APP_NAME=Nyaya
APP_ENV=local                      # local | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- Storage / infrastructure (later phases) ---------------------------------
# Local defaults for docker-compose style setups; adjust to your environment.
DATABASE_URL=postgresql+asyncpg://nyaya:nyaya@localhost:5432/nyaya
QDRANT_URL=http://localhost:6333
QDRANT_BNS_COLLECTION=bns_chunks
QDRANT_USER_DOCUMENT_COLLECTION=user_document_chunks
REDIS_URL=redis://localhost:6379/0

# --- LLM provider -------------------------------------------------------------
# Two deployment shapes, selected by LLM_PROVIDER + COMPOSE_PROFILES:
#
# 1. Keyless local (default): COMPOSE_PROFILES=ollama starts the in-stack
#    Ollama container and one-shot model pull; LLM_BASE_URL points at it.
# 2. API-key hosted provider: leave COMPOSE_PROFILES empty (no Ollama
#    container is created), set LLM_PROVIDER/LLM_API_KEY to your provider
#    (openai, gemini, grok, groq, openrouter, or any OpenAI-compatible
#    endpoint). Built-in providers have doc-verified default base URLs —
#    leave LLM_BASE_URL empty unless you run a proxy/custom endpoint.
# The provider sits behind the LLMProvider registry — swapping is config-only.
# NOTE (effective-config precedence, D-090): non-secret settings saved in the
# /settings admin console persist in storage/admin/admin.json and WIN over
# these environment values until cleared in the console — after that, these
# values are the fallback. The startup log and GET /api/v1/health/llm
# ("config_source") state which source is effective. LLM_API_KEY here is the
# bootstrap default AND the restart fallback: a key saved in the console wins
# for the running process but is held in MEMORY ONLY (never written to disk),
# so after a restart this env value applies again.
COMPOSE_PROFILES=ollama
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
# LLM_API_KEY=                    # secret — set in .env only, leave blank here
# Per-request LLM HTTP timeout and Ollama context/output caps. Grounded
# prompts with 10 evidence chunks exceed Ollama's ~4k default context
# (silent truncation); num_predict bounds runaway generations.
LLM_TIMEOUT_SECONDS=300
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=768

# --- Embeddings / retrieval (later phases) ------------------------------------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32
DENSE_TOP_K=20
SPARSE_TOP_K=20
# Phase 2 chunk artifact serving statute retrieval (chat fails closed until
# set; the Docker default is the full BNS corpus,
# ./data/processed/bns_corpus.jsonl (generated by scripts/ingest.py).
# RETRIEVAL_CORPUS_PATH=
# Dense retrieval backend (D-092): auto = use the Qdrant bns_chunks
# collection when reachable and populated (scripts/bootstrap.sh fills it),
# falling back to the in-process cosine index; qdrant = require Qdrant
# (chat fails closed 503 when unusable); in-process = never contact Qdrant.
# RETRIEVAL_DENSE_BACKEND=auto

# --- Uploads (later phases) ----------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_TYPES=application/pdf
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=5

# --- Production worker path (Phase 10; DECISIONS.md D-030) --------------------
# "redis" enables the arq worker path: uploads are queued on Redis and the
# worker container ingests them against the shared Redis store/index.
DOCUMENTS_BACKEND=memory
# --- Rate limits (see above) and query-cost modelling (F-034..F-036) ----------
# Optional: per-1k-token rates for hosted providers; local Ollama is free.
LLM_COST_PER_1K_INPUT_TOKENS=0
LLM_COST_PER_1K_OUTPUT_TOKENS=0

# --- Speech (STT/TTS, DECISIONS D-079) -------------------------------------
# Local AI4Bharat providers by default; no paid/cloud speech APIs. Weights
# load lazily on first use, so the API boots without torch installed and
# speech requests fail closed (503) until the models are available.
# "indicconformer" (preferred; Hub weights are license-gated — accept the
# licence and authenticate, or use the public-weights "whisper" fallback).
# Local defaults: faster-whisper (CTranslate2, int8 CPU — fast, low RAM,
# multilingual) for STT and Indic Parler-TTS lineage for TTS.
# Alternatives: SPEECH_STT_PROVIDER in {faster-whisper, indicconformer, whisper, browser, openai}
#               SPEECH_TTS_PROVIDER in {piper, parler-tts, openai, browser}
#               (parler-tts requires `pip install parler_tts==0.2.3` — it is
#                NOT in requirements-speech.txt because it pins
#                transformers==4.46.1, which Trivy blocks for CRITICAL CVEs;
#                without the package the provider fails closed 503)
# "browser" = zero server RAM: STT uses the browser Web Speech API and TTS
# uses speechSynthesis, entirely client-side. Recommended for small (2 CPU /
# 4 GB) servers; the server speech endpoints fail closed with a clear
# message if a client reaches them anyway.
SPEECH_STT_PROVIDER=faster-whisper
# Piper is the lightweight local TTS default (D-081): ~100 ms CPU synthesis,
# ~200 MB RAM. Hindi is pinned to hi_IN-pratham-medium; the model below is
# the English voice. Voices auto-download to storage/piper-voices on first
# use, or set SPEECH_TTS_VOICES_DIR to a pre-baked directory.
SPEECH_TTS_PROVIDER=piper
SPEECH_STT_MODEL=small
SPEECH_TTS_MODEL=en_US-lessac-medium
# SPEECH_TTS_VOICES_DIR=
# Cloud (OpenAI-compatible; opt-in, never default). Works with OpenAI, Groq,
# or any compatible gateway. Keys are secrets — set in .env only.
# SPEECH_STT_BASE_URL=https://api.openai.com/v1
# SPEECH_TTS_BASE_URL=https://api.openai.com/v1
# SPEECH_STT_API_KEY=                 # secret — .env only
# SPEECH_TTS_API_KEY=                 # secret — .env only
# SPEECH_TTS_VOICE=alloy
# auto|cuda|cpu — STT and TTS are separate because both models must not sit
# permanently on a small GPU (6 GB VRAM class).
SPEECH_STT_DEVICE=auto
SPEECH_TTS_DEVICE=auto
# IndicConformer adapters tried (acoustic scoring) for auto-detection.
SPEECH_STT_AUTO_LANGUAGES=en,hi,bn,ta
# Maximum accepted audio upload size, MB.
MAX_AUDIO_UPLOAD_MB=15
# Speech requests per session per minute.
RATE_LIMIT_SPEECH_PER_MINUTE=10
# Eagerly load STT/TTS weights at startup (background) so the first speech
# request skips model-load latency. Costs up to ~1-3 GB RAM held permanently.
# 0 (lazy) is the safe default for small servers; the models then load on
# first use and speech failures never block chat.
SPEECH_PRELOAD=0

# --- Admin console (D-080) -----------------------------------------------------
# The /settings admin console (path routing, react-router) is DISABLED until both values are set.
# Credentials live only in env / .env (never in code or the frontend).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional dedicated cookie-signing secret; falls back to a value derived
# from ADMIN_PASSWORD. Set a random 32+ byte hex string in production.
ADMIN_SESSION_SECRET=
# Where persisted admin settings + corpus manifest are stored (JSON, 0600,
# always secret-free — console-entered API keys are memory-only and fall back
# to the environment after a restart). Compose mounts this inside the storage
# volume so settings survive restarts.
ADMIN_SETTINGS_PATH=storage/admin/admin.json
